<div id="public-notes-container" style="margin-top: 50px; padding: 20px; border-top: 1px solid #333; font-family: inherit;">
    <h3 style="color: #e91e63; border-bottom: 1px solid #e91e63; display: inline-block; margin-bottom: 20px;">Notas Públicas</h3>
    <div id="notes-list" style="margin-bottom: 20px;">Cargando notas...</div>

    <hr style="border: 0; border-top: 1px solid #222; margin: 20px 0;">

    <form id="note-form" style="display: flex; flex-direction: column; gap: 10px; max-width: 500px;">
        <input type="text" id="note-author" placeholder="Tu nombre (opcional)" style="padding: 10px; background: #0a0a0a; color: white; border: 1px solid #333; border-radius: 4px;">
        <textarea id="note-content" placeholder="Escribe una nota pública..." required style="padding: 10px; background: #0a0a0a; color: white; border: 1px solid #333; border-radius: 4px; min-height: 80px; font-family: inherit;"></textarea>

        <div style="font-size: 0.9em; color: #888; display: flex; align-items: center; gap: 10px;">
            <span>Anti-spam: ¿Cuánto es 2 + 2?</span>
            <input type="number" id="spam-check" required style="width: 60px; background: #0a0a0a; color: white; border: 1px solid #333; border-radius: 4px; padding: 5px;">
        </div>

        <button type="submit" style="padding: 12px; background: #e91e63; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; transition: opacity 0.2s;">Publicar Nota</button>
    </form>
</div>

<script>
    const SUPABASE_URL = 'https://sywzhcqkdploazcvqfev.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN5d3poY3FrZHBsb2F6Y3ZxZmV2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgxNjc4MjEsImV4cCI6MjA5Mzc0MzgyMX0.hiNuqMqz5yQNBT8RdizRFru3VpY6C5e5AVdi-2FQH0U';
    const PAGE_SLUG = window.location.pathname;

    async function loadNotes() {
        try {
            const response = await fetch(`${SUPABASE_URL}/rest/v1/public_notes?page_slug=eq.${encodeURIComponent(PAGE_SLUG)}&select=*&order=created_at.desc`, {
                headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` }
            });
            const notes = await response.json();
            const list = document.getElementById('notes-list');

            if (!notes || notes.length === 0) {
                list.innerHTML = '<p style="color: #666; font-style: italic;">No hay notas aún. ¡Sé el primero!</p>';
                return;
            }

            list.innerHTML = notes.map(n => `
                <div style="margin-bottom: 15px; padding: 15px; background: #111; border-left: 4px solid #e91e63; border-radius: 0 4px 4px 0;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <strong style="color: #e91e63;">${n.author || 'Anónimo'}</strong>
                        <span style="font-size: 0.75em; color: #555;">${new Date(n.created_at).toLocaleDateString()}</span>
                    </div>
                    <p style="margin: 0; color: #ccc; line-height: 1.4;">${n.content.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>
                </div>
            `).join('');
        } catch (err) {
            console.error(err);
        }
    }

    document.getElementById('note-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = e.target.querySelector('button');
        const author = document.getElementById('note-author').value;
        const content = document.getElementById('note-content').value;
        const spam = document.getElementById('spam-check').value;

        if (spam !== "4") {
            alert("Respuesta anti-spam incorrecta.");
            return;
        }

        btn.disabled = true;
        btn.innerText = 'Publicando...';

        try {
            const res = await fetch(`${SUPABASE_URL}/rest/v1/public_notes`, {
                method: 'POST',
                headers: {
                    'apikey': SUPABASE_KEY,
                    'Authorization': `Bearer ${SUPABASE_KEY}`,
                    'Content-Type': 'application/json',
                    'Prefer': 'return=representation'
                },
                body: JSON.stringify({
                    page_slug: PAGE_SLUG,
                    author: author.trim() || 'Anónimo',
                    content: content.trim()
                })
            });

            if (res.ok) {
                document.getElementById('note-content').value = '';
                document.getElementById('spam-check').value = '';
                loadNotes();
            } else {
                alert("Error al guardar la nota. Asegúrate de haber ejecutado el SQL en Supabase.");
            }
        } catch (err) {
            alert("Error de conexión.");
        } finally {
            btn.disabled = false;
            btn.innerText = 'Publicar Nota';
        }
    });

    loadNotes();
</script>
