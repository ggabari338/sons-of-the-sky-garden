<style>
/* 1. EFECTO DE LÍNEAS DE ESCANEADO (SCANLINES) */
body::before {
    content: " ";
    display: block;
    position: fixed;
    top: 0; left: 0; bottom: 0; right: 0;
    /* Crea las líneas horizontales finas */
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.15) 50%),
                linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
    z-index: 9999;
    background-size: 100% 3px, 3px 100%;
    pointer-events: none; /* Permite hacer click a través de la capa */
}

/* 2. EFECTO DE PARPADEO SUTIL (FLICKER) */
body::after {
    content: " ";
    display: block;
    position: fixed;
    top: 0; left: 0; bottom: 0; right: 0;
    background: rgba(18, 16, 16, 0.03);
    opacity: 0;
    z-index: 10000;
    pointer-events: none;
    animation: crt-flicker 0.15s infinite;
}

@keyframes crt-flicker {
    0% { opacity: 0.1; }
    50% { opacity: 0.05; }
    100% { opacity: 0.1; }
}

/* 3. BRILLO TIPO TERMINAL (GLOW) */
body {
    text-shadow: 0 0 15px rgba(255, 152, 0, 0.3);
    background-color: #050505 !important; /* Un negro más profundo */
}

/* 4. VIÑETEADO (Oscurece las esquinas como un monitor viejo) */
html {
    background: radial-gradient(circle, rgba(0,0,0,0) 60%, rgba(0,0,0,0.4) 100%);
    min-height: 100vh;
}

/* Mejora de los enlaces para que brillen al pasar el ratón */
a:hover {
    text-shadow: 0 0 8px #ff9800;
    transition: 0.2s;
}

/* Estilo para barras de scroll estilo retro */
::-webkit-scrollbar {
    width: 8px;
}
::-webkit-scrollbar-track {
    background: #050505;
}
::-webkit-scrollbar-thumb {
    background: #ff9800;
    border-radius: 0px;
}
</style>
