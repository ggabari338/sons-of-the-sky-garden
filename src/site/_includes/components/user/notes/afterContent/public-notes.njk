<div id="public-notes-container" style="margin-top: 50px; padding: 20px; border-top: 1px solid #333; font-family: inherit;">
    <h3 style="color: #ff9800; border-bottom: 1px solid #ff9800; display: inline-block; margin-bottom: 20px;">NOTAS DEL ARCHIVO</h3>

    <div id="notes-list" style="margin-bottom: 20px;">Cargando registros...</div>

    <hr style="border: 0; border-top: 1px solid #222; margin: 20px 0;">

    <form id="note-form" style="display: flex; flex-direction: column; gap: 10px; max-width: 500px;">
        <div style="display: flex; gap: 10px;">
            <input type="text" id="note-author" placeholder="Alias (Autor)..." required style="flex: 1; padding: 10px; background: #0a0a0a; color: white; border: 1px solid #333; border-radius: 4px;">
            <input type="text" id="note-concept" placeholder="Concepto (Tema)..." required style="flex: 1; padding: 10px; background: #0a0a0a; color: white; border: 1px solid #333; border-radius: 4px;">
        </div>
        <textarea id="note-content" placeholder="Escribe el reporte aquí..." required style="padding: 10px; background: #0a0a0a; color: white; border: 1px solid #333; border-radius: 4px; min-height: 80px; font-family: inherit;"></textarea>

        <div style="font-size: 0.9em; color: #ff9800; display: flex; align-items: center; gap: 10px; font-weight: bold;">
            <span>Clave de envío:</span>
            <input type="password" id="spam-check" required placeholder="???" style="width: 80px; background: #0a0a0a; color: #ff9800; border: 1px solid #ff9800; border-radius: 4px; padding: 5px; text-align: center;">
        </div>

        <button type="submit" style="padding: 12px; background: #ff9800; color: black; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; transition: background 0.2s; text-transform: uppercase;">Publicar Reporte</button>
    </form>
</div>

<script>
    const SUPABASE_URL = 'https://sywzhcqkdploazcvqfev.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN5d3poY3FrZHBsb2F6Y3ZxZmV2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgxNjc4MjEsImV4cCI6MjA5Mzc0MzgyMX0.hiNuqMqz5yQNBT8RdizRFru3VpY6C5e5AVdi-2FQH0U';
    const PAGE_SLUG = window.location.pathname;

    // FUNCIÓN DE ELIMINAR
    async function deleteNote(id) {
        const code = prompt("AUTORIZACIÓN REQUERIDA: Ingrese código de Administrador para completar la operación:");
        if (code !== "C-3") {
            alert("ACCESO DENEGADO.");
            return;
        }

        if (confirm("¿Confirmar eliminación del registro?")) {
            try {
                const res = await fetch(`${SUPABASE_URL}/rest/v1/public_notes?id=eq.${id}`, {
                    method: 'DELETE',
                    headers: {
                        'apikey': SUPABASE_KEY,
                        'Authorization': `Bearer ${SUPABASE_KEY}`,
                        'Content-Type': 'application/json'
                    }
                });
                if (res.ok) {
                    loadNotes();
                } else {
                    const err = await res.json();
                    console.error("Error Supabase:", err);
                    alert("Error al borrar: Asegúrate de haber ejecutado el SQL del Paso 1.");
                }
            } catch (err) { alert("Error de conexión."); }
        }
    }

    async function loadNotes() {
        try {
            // Buscamos notas que empiecen por el slug de esta página (para incluir conceptos)
            const response = await fetch(`${SUPABASE_URL}/rest/v1/public_notes?page_slug=ilike.${encodeURIComponent(PAGE_SLUG)}*&select=*&order=created_at.desc`, {
                headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` }
            });
            const notes = await response.json();
            const list = document.getElementById('notes-list');

            if (!notes || notes.length === 0) {
                list.innerHTML = '<p style="color: #666; font-style: italic;">Sin reportes recientes.</p>';
                return;
            }

            list.innerHTML = notes.map(n => {
                const concept = n.page_slug.includes('concept:') ? n.page_slug.split('concept:')[1] : 'General';
                return `
                <div style="margin-bottom: 15px; padding: 15px; background: #111; border-left: 4px solid #ff9800; border-radius: 0 4px 4px 0; position: relative;">
                    <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
                        <div>
                            <strong style="color: #ff9800;">${(n.author || 'Anónimo').replace(/</g, "&lt;")}</strong>
                            <span style="color: #555; margin: 0 5px;">|</span>
                            <span style="color: #888; font-size: 0.9em;">Concepto: ${concept.replace(/</g, "&lt;")}</span>
                        </div>
                        <button onclick="deleteNote('${n.id}')" style="background: none; border: none; color: #444; cursor: pointer; font-size: 1.5em; line-height: 1; padding: 0 5px;" title="Eliminar (C-3)">×</button>
                    </div>
                    <p style="margin: 0; color: #ccc; line-height: 1.4; white-space: pre-wrap;">${n.content.replace(/</g, "&lt;")}</p>
                    <div style="font-size: 0.7em; color: #444; margin-top: 10px;">REC: ${new Date(n.created_at).toLocaleString()}</div>
                </div>
                `}).join('');
        } catch (err) { console.error(err); }
    }

    document.getElementById('note-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = e.target.querySelector('button');
        const author = document.getElementById('note-author').value;
        const concept = document.getElementById('note-concept').value;
        const content = document.getElementById('note-content').value;
        const spam = document.getElementById('spam-check').value;

        if (spam !== "369") {
            alert("ACCESO DENEGADO: Clave incorrecta.");
            return;
        }

        btn.disabled = true;
        btn.innerText = 'ENVIANDO...';

        try {
            const res = await fetch(`${SUPABASE_URL}/rest/v1/public_notes`, {
                method: 'POST',
                headers: {
                    'apikey': SUPABASE_KEY,
                    'Authorization': `Bearer ${SUPABASE_KEY}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    page_slug: PAGE_SLUG + (concept ? 'concept:' + concept : ''),
                    author: author.trim(),
                    content: content.trim()
                })
            });

            if (res.ok) {
                document.getElementById('note-form').reset();
                loadNotes();
            }
        } catch (err) { alert("Error de sistema."); }
        finally {
            btn.disabled = false;
            btn.innerText = 'Publicar Reporte';
        }
    });

    loadNotes();
</script>
