<div class="random-note-sidebar" style="margin-top: 20px; padding: 10px; border: 1px solid #333; background: #050505; border-radius: 4px; text-align: center;">
    <div style="color: #ff9800; font-family: monospace; font-size: 0.65em; margin-bottom: 8px; letter-spacing: 1px; opacity: 0.8;">
        RECURSOS ALEATORIOS
    </div>

    <button id="sidebar-random-btn" style="width: 100%; background: #ff9800; color: black; border: none; padding: 8px; font-family: monospace; font-weight: bold; cursor: pointer; font-size: 0.75em; transition: 0.2s; text-transform: uppercase;">
        [ INICIAR ]
    </button>

    <div id="sidebar-random-status" style="font-size: 0.6em; color: #444; margin-top: 5px; font-family: monospace; height: 1em;"></div>
</div>

<script>
    document.getElementById('sidebar-random-btn').onclick = async function() {
        const btn = this;
        const status = document.getElementById('sidebar-random-status');

        btn.innerText = "BUSCANDO...";
        btn.disabled = true;
        status.innerText = "ACCEDIENDO AL ÍNDICE...";

        try {
            const response = await fetch('/search-index.json');
            const data = await response.json();

            // Filtramos para obtener solo páginas válidas (que no sean la actual ni la home)
            const currentPath = window.location.pathname;
            const pages = data.filter(p => p.url && p.url !== currentPath && p.url !== '/' && p.title);

            if (pages.length > 0) {
                const randomPage = pages[Math.floor(Math.random() * pages.length)];
                status.innerText = "REDIRECCIONANDO...";
                window.location.href = randomPage.url;
            } else {
                btn.innerText = "ERROR";
                setTimeout(() => { btn.innerText = "[ INICIAR ]"; btn.disabled = false; }, 2000);
            }
        } catch (e) {
            btn.innerText = "ERROR";
            status.innerText = "FALLO DE CONEXIÓN";
            setTimeout(() => { btn.innerText = "[ INICIAR ]"; btn.disabled = false; status.innerText = ""; }, 2000);
        }
    };
</script>
